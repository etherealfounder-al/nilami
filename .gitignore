# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# The admin app: installed and built on its own, then embedded in the binary.
/web/node_modules
/web/dist

# Where that build lands inside the Go module before `go build`. The .gitkeep
# keeps the embed valid on a fresh checkout, where the panel answers 503 until
# the frontend has been built.
/api/internal/web/dist/*
!/api/internal/web/dist/.gitkeep

# Environment files. .env.example is committed: it documents the surface and
# holds no secrets.
.env*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo
*-debug.log*
