# ─── Supabase ────────────────────────────────────────────────────────────────
# Authentication only. Public by design: these ship in the browser bundle, and
# the API verifies the resulting tokens itself against Supabase's public keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ─── Nilami API ──────────────────────────────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_: the browser must not learn
# the API's address or hold its credential. Only the Next.js server calls it.
API_BASE_URL=https://api.<your-domain>
API_SERVICE_TOKEN=<32+ random characters, same value as SERVICE_TOKEN on the VPS>

# ─── Media ───────────────────────────────────────────────────────────────────
# Hostname that serves uploaded images, added to next/image's allowed hosts.
# Either the bucket's r2.dev address or a custom domain such as cdn.<your-domain>.
NEXT_PUBLIC_MEDIA_HOSTNAME=cdn.<your-domain>
