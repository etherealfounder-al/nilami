# The server's environment.
#
# In production these are set in Coolify, which also generates the Postgres
# password and assigns the domain; docker-compose.yaml shows how they reach the
# container. This file documents the surface and holds no secrets.

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nilami:<password>@postgres:5432/nilami?sslmode=disable

# Shared credential for the endpoints only a trusted caller may reach. At least
# 32 characters; the server refuses to start with less.
SERVICE_TOKEN=<32+ random characters>

# ─── Optional ────────────────────────────────────────────────────────────────
ADDR=:8080

# Cloudflare R2, S3-compatible. Uploads are presigned, so photographs go
# straight from the browser to storage and never pass through this process.
# Without these the site runs and only uploading is unavailable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://cdn.<your-domain>

# Drops the Secure flag from the session cookie. Only a local development
# server over plain http has any business setting this.
COOKIE_INSECURE=

DB_MAX_CONNS=8
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000
